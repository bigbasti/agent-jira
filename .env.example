# Copy this file to .env and fill in SESSION_SECRET before running `docker compose up`.
# Generate one with: openssl rand -hex 32

# The host port docker-compose publishes the server on (docker-compose.yml maps this to
# container port 3000 — it does not change what port the server inside the container
# listens on, since PORT is never passed into the container's own environment). Change
# this if 3000 is already taken on the host, e.g. PORT=8080 to reach it at :8080.
PORT=3000

# Where the SQLite database file lives. Inside the container this should stay under
# /data, which docker-compose mounts as the named volume `agent-kanban-data` — anything
# written elsewhere in the container is lost when it is recreated.
DATABASE_PATH=./data/agent-kanban.db

# Required in production: a random string of at least 32 characters used to sign session
# cookies. The server refuses to start in production without one. Never reuse the example
# value below — generate your own with `openssl rand -hex 32`.
SESSION_SECRET=change-me-to-a-random-string-of-at-least-32-characters

# The externally-reachable URL of this server, used to build OAuth metadata and the MCP
# connection URL agents are told to use. Set this to the address agents and browsers will
# actually reach — e.g. https://board.example.com when running behind a reverse proxy.
PUBLIC_URL=http://localhost:3000

NODE_ENV=development

# Whether to trust `X-Forwarded-*` headers from an upstream reverse proxy when determining
# a client's IP address (used by rate limiting). Leave this `false` unless the server sits
# behind a reverse proxy you control — trusting these headers from an untrusted or absent
# proxy lets a client forge its own IP and bypass rate limits entirely. When you do put a
# proxy (nginx, Caddy, openship, ...) in front of this server, set this to `true` so every
# agent registration isn't attributed to the proxy's single IP.
TRUST_PROXY=false
